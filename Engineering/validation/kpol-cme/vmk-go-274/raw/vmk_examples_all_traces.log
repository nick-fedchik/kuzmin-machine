=== [BLOCK 1] SOURCE CODE / PROGRAM SPECIFICATION (BmsSafetyCascade, KPOL-CME-2) ===
  01 | # @stdin Cell_Delta_mV
  02 | # @stdout Cell_Delta_mV, Module_Thermal_Guard, Pack_Fault_Latch, Contactor_Interlock
  03 | Problem BmsSafetyCascade {
  04 |     Invariants {
  05 |         inv_cell_delta: Cell_Delta_mV >= 0;
  06 |         inv_mod_thermal: Module_Thermal_Guard >= 0;
  07 |         inv_pack_latch: Pack_Fault_Latch >= 0;
  08 |         inv_contactor: Contactor_Interlock >= 0;
  09 |     }
  10 | }
  11 | Solution BmsSafetyCascade {
  12 |     state Cell_Delta_mV: Int32 = 0;
  13 |     state Module_Thermal_Guard: Int32 = 0;
  14 |     state Pack_Fault_Latch: Int32 = 2;
  15 |     state Contactor_Interlock: Int32 = 10;
  16 |
  17 |     event EvCellDelta(delta_mv: Int32);
  18 |
  19 |     rule RCellDelta on EvCellDelta when delta_mv >= 50 and delta_mv <= 5000 {
  20 |         set Cell_Delta_mV := Cell_Delta_mV + 1;
  21 |     }
  22 |     rule RModuleThermal on change(Cell_Delta_mV) when Cell_Delta_mV >= 1 {
  23 |         set Module_Thermal_Guard := Module_Thermal_Guard + 1;
  24 |     }
  25 |     rule RPackFaultLatch on change(Module_Thermal_Guard) when Module_Thermal_Guard >= 1 {
  26 |         set Pack_Fault_Latch := Pack_Fault_Latch - 1;
  27 |     }
  28 |     rule RContactorInterlock on change(Pack_Fault_Latch) when not (Pack_Fault_Latch == 2) {
  29 |         set Contactor_Interlock := Pack_Fault_Latch;
  30 |     }
  31 | }
  32 | Proof BmsSafetyCascade {
  33 |     scenario BmsFourLevelProtectionAndLatch {
  34 |         step EvCellDelta(delta_mv = 15);
  35 |         expect Cell_Delta_mV == 0;
  36 |         expect Contactor_Interlock == 10;
  37 |         step EvCellDelta(delta_mv = 120);
  38 |         expect Cell_Delta_mV == 1;
  39 |         expect Module_Thermal_Guard == 1;
  40 |         expect Pack_Fault_Latch == 1;
  41 |         expect Contactor_Interlock == 1;
  42 |         step EvCellDelta(delta_mv = 180);
  43 |         expect Cell_Delta_mV == 2;
  44 |         expect Module_Thermal_Guard == 2;
  45 |         expect Pack_Fault_Latch == 0;
  46 |         expect Contactor_Interlock == 0;
  47 |         step EvCellDelta(delta_mv = 250);
  48 |         expect Cell_Delta_mV == 3;
  49 |         expect Module_Thermal_Guard == 3;
  50 |         expect Pack_Fault_Latch == 0;
  51 |         expect Contactor_Interlock == 0;
  52 |     }
  53 | }

