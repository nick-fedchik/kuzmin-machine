== W2 consistency script ==
import re
import struct
import sys
from pathlib import Path

sys.path.insert(0, str(Path("sw/kpol-ref").resolve()))
from kpol_reference import compile_concept_microcode_bram_image, parse_module

for name, action in (("increase", 1), ("decrease", 2)):
    source = Path(f"hw/tests/kpol_bram_pipeline_{name}.kpol").read_text()
    image = compile_concept_microcode_bram_image(parse_module(source))
    expected = (10, 20, (action << 24) | (3 << 8) | 4, 0)
    words = struct.unpack_from("<4I", image)
    assert words == expected, (name, words, expected)
    print(f"W2_EXAMPLE_OK {name}: {[hex(word) for word in words]}")

path = "specs/hw/kpol-image-loader-pipeline-contract.md"
doc = Path(path).read_text()
for bits, field in (
    ("7:0", "pred_opcode"),
    ("15:8", "guard_flags"),
    ("23:16", "hazard_limit"),
    ("31:24", "action_opcode"),
):
    assert f"`[{bits}]`: `{field}`" in doc
    print(f"B4_W2_DOCUMENT_OK [{bits}]={field}")

rtl = Path("hw/rtl/core/km_concept_micro_engine.sv").read_text()
for field, lo, hi in (
    ("pred_opcode", 64, 71),
    ("guard_flags", 72, 79),
    ("hazard_limit", 80, 87),
    ("action_opcode", 88, 95),
):
    assert re.search(
        rf"assign\s+{field}_w\s*=\s*descriptor_i\[{hi}:{lo}\]", rtl
    )
    print(f"CME_RTL_FIELD_OK {field}=descriptor_i[{hi}:{lo}]")

print("PASS: documented W2 matches actual compiler examples and RTL slices")
