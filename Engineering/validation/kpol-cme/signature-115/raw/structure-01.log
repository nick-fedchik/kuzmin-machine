import json
from pathlib import Path
import subprocess

index = Path("Project/registers/wp-index.json")
base = json.loads(subprocess.check_output([
    "git", "show",
    "ca2936441090b0facef414aa83e4f489f0d7664f:Project/registers/wp-index.json"
]))
current = json.loads(index.read_text())
old = {row["path"]: row for row in base["entries"]}
new = {row["path"]: row for row in current["entries"]}
assert len(new) == len(current["entries"])
assert all(new[path] == row for path, row in old.items())
prefix = "Engineering/validation/kpol-cme/signature-115/"
assert set(new) - set(old) == {
    prefix + name for name in (
        "report.md", "raw/negative-control-01.log", "raw/regressions-01.log",
        "raw/checks-01.log", "raw/structure-01.log",
    )
}
assert all(Path(path).exists() for path in new)
assert list(new) == sorted(new)
print(f"INDEX: {len(new)} entries; all {len(old)} previous entries preserved; all paths exist")

