=== [BLOCK 1] SOURCE CODE / PROGRAM SPECIFICATION (BmsSafetyCascade, KPOL-CME-2) ===
  01 | Problem BmsSafetyCascade {
  02 |     Invariants {
  03 |         inv_cell_delta: Cell_Delta_mV >= 0;
  04 |         inv_mod_thermal: Module_Thermal_Guard >= 0;
  05 |         inv_pack_latch: Pack_Fault_Latch >= 0;
  06 |         inv_contactor: Contactor_Interlock >= 0;
  07 |     }
  08 | }
  09 |
  10 | Solution BmsSafetyCascade {
  11 |     state Cell_Delta_mV: Int32 = 0;
  12 |     state Module_Thermal_Guard: Int32 = 0;
  13 |     state Pack_Fault_Latch: Int32 = 2;
  14 |     state Contactor_Interlock: Int32 = 10;
  15 |
  16 |     event EvCellDelta(delta_mv: Int32);
  17 |
  18 |     rule RCellDelta on EvCellDelta when delta_mv >= 50 and delta_mv <= 5000 {
  19 |         set Cell_Delta_mV := Cell_Delta_mV + 1;
  20 |     }
  21 |     rule RModuleThermal on change(Cell_Delta_mV) when Cell_Delta_mV >= 1 {
  22 |         set Module_Thermal_Guard := Module_Thermal_Guard + 1;
  23 |     }
  24 |     rule RPackFaultLatch on change(Module_Thermal_Guard) when Module_Thermal_Guard >= 1 {
  25 |         set Pack_Fault_Latch := Pack_Fault_Latch - 1;
  26 |     }
  27 |     rule RContactorInterlock on change(Pack_Fault_Latch) when not (Pack_Fault_Latch == 2) {
  28 |         set Contactor_Interlock := Pack_Fault_Latch;
  29 |     }
  30 | }
  31 |
  32 | Proof BmsSafetyCascade {
  33 |     scenario BmsFourLevelProtectionAndLatch {
  34 |         step EvCellDelta(delta_mv = 15);
  35 |         expect Cell_Delta_mV == 0;
  36 |         expect Contactor_Interlock == 10;
  37 |
  38 |         step EvCellDelta(delta_mv = 120);
  39 |         expect Cell_Delta_mV == 1;
  40 |         expect Module_Thermal_Guard == 1;
  41 |         expect Pack_Fault_Latch == 1;
  42 |         expect Contactor_Interlock == 1;
  43 |
  44 |         step EvCellDelta(delta_mv = 180);
  45 |         expect Cell_Delta_mV == 2;
  46 |         expect Module_Thermal_Guard == 2;
  47 |         expect Pack_Fault_Latch == 0;
  48 |         expect Contactor_Interlock == 0;
  49 |
  50 |         step EvCellDelta(delta_mv = 250);
  51 |         expect Cell_Delta_mV == 3;
  52 |         expect Module_Thermal_Guard == 3;
  53 |         expect Pack_Fault_Latch == 0;
  54 |         expect Contactor_Interlock == 0;
  55 |     }
  56 | }

