import hashlib
import re
import subprocess
from pathlib import Path

BASE = "727c19ecb08a6bd45cffea541a64db01acaab148"


def blocks(text):
    return re.findall(r"^```kpol\n(.*?)^```", text, re.M | re.S)


for minor in range(1, 10):
    path = f"specs/kpol/kpol-0.{minor}.0.md"
    original = subprocess.check_output(["git", "show", f"{BASE}:{path}"])
    stub = Path(path).read_text(encoding="utf-8")
    assert f"https://github.com/nick-fedchik/kuzmin-machine/blob/{BASE}/{path}" in stub
    assert "```kpol" not in stub
    print(f"ARCHIVE_OK {path} original_sha256={hashlib.sha256(original).hexdigest()}")

original = subprocess.check_output(
    ["git", "show", f"{BASE}:specs/kpol/kpol-0.1.0.md"], text=True
)
fixture = Path("sw/kpol-ref/tests/fixtures/kpol-v01-examples.md").read_text(
    encoding="utf-8"
)
expected = blocks(original)
actual = blocks(fixture)
assert len(expected) == len(actual) == 3
assert actual == expected
for index, block in enumerate(actual, 1):
    print(f"FIXTURE_IDENTICAL {index} sha256={hashlib.sha256(block.encode()).hexdigest()}")

mutant = fixture.replace("Temp > 120", "Temp > 121", 1)
assert blocks(mutant) != expected
print("NEGATIVE_CONTROL_OK: a changed fixture block is not equal to the Git original")
print("PASS: archive targets exist; historical fixtures preserved without code changes")
